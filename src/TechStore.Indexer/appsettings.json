{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Elastic.Transport": "Warning"
    }
  },
  "ConnectionStrings": {
    "Sql": "Server=.\\SQLEXPRESS;Database=TechStore;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "Alias": "products",
    "NumberOfShards": 1,
    "NumberOfReplicas": 0
  },
  "Indexer": {
    "OutboxBatchSize": 500,
    "PollInterval": "00:00:01",
    "ReindexPageSize": 5000,
    "BulkSize": 2000,
    "BulkParallelism": 3
  }
}
